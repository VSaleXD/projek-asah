# Salin ke .env lalu isi.
# Neon: Dashboard > Connection string (sudah memuat sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stok
PORT=3000
# Alamat frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173
# Kode akses staf. Kosongkan hanya saat pengembangan lokal.
KODE_AKSES=
